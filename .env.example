# LLM 配置
LLM_PROVIDER=deepseek
LLM_FALLBACK_PROVIDER=minimax
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_MODEL=MiniMax-Text-01
MINIMAX_BASE_URL=https://api.minimax.chat/v1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 数据库
DATABASE_URL=postgresql+psycopg2://gov:${POSTGRES_PASSWORD}@postgres:5432/gov_assistant

# Embedding
EMBEDDING_PROVIDER=minimax
EMBEDDING_MODEL=embo-01
EMBEDDING_DIMENSION=1536

# Rerank（默认 offline 不依赖 API；正式环境可切 API 模型）
RERANK_PROVIDER=offline
RERANK_MODEL=bge-reranker-base
RERANK_BASE_URL=
RERANK_API_KEY=

POSTGRES_PASSWORD=gov123456
