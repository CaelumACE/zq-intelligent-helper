# LLM 配置：S03 起默认 MiniMax，DeepSeek 作为自动回退通道
LLM_PROVIDER=minimax
LLM_FALLBACK_PROVIDER=deepseek
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_MODEL=MiniMax-Text-01
MINIMAX_BASE_URL=https://api.minimax.chat/v1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 数据库（Docker部署固定连 compose 里的 postgres；改密码需与下方 POSTGRES_PASSWORD 同步）
DATABASE_URL=postgresql+psycopg2://gov:gov123456@postgres:5432/gov_assistant

# Embedding
EMBEDDING_PROVIDER=minimax
EMBEDDING_MODEL=embo-01
EMBEDDING_DIMENSION=1536

# Rerank：默认 offline 为内置 n-gram 重排，不依赖外部 API。
# Demo 期可临时启用 SiliconFlow 在线 Rerank；RERANK_BASE_URL 填到 /v1（不含 /rerank）。
# RERANK_PROVIDER=siliconflow
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_API_KEY=sk-xxx
RERANK_PROVIDER=offline
RERANK_MODEL=n-gram-offline
RERANK_BASE_URL=
RERANK_API_KEY=

# 安全密钥：部署前必须改成独立随机值；不设置会在容器启动时随机生成，但重启后登录态会失效。
JWT_SECRET=
# 首次部署自动创建 admin 账号的初始密码；不设置会随机生成并打印到后端日志。
ADMIN_PASSWORD=
# CORS：私有化同域部署保持默认即可；跨域访问再按需添加，逗号分隔。
CORS_ORIGINS=http://localhost,http://127.0.0.1

POSTGRES_PASSWORD=gov123456

# 会话策略：false=单点登录（默认，新登录踢掉旧会话）；true=允许多端同时在线
# 改密/禁用账号/管理员重置密码始终全端失效，不受此开关影响
ALLOW_MULTI_SESSION=false

# 超级管理员账号（凌驾普通管理员之上，不可被删除/修改）
SUPER_ADMIN_USERNAME=super_admin
# 必填；未配置服务拒绝启动。请改为高强度随机口令，不要复用历史口令。
SUPER_ADMIN_PASSWORD=
